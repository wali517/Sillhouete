# ==============================================================================
# Sillhouete Environment Variables Configuration
# Copy this file to .env.local for local development or configure in your live
# hosting platform (Vercel, Netlify, Render, Railway, AWS, etc.)
# ==============================================================================

# MongoDB Connection String (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/sillhouete?retryWrites=true&w=majority

# ==============================================================================
# Stripe Configuration (TEST MODE ONLY)
# ==============================================================================
# Set to 'true' to enforce Stripe Test Mode across the entire application.
# Live keys (sk_live_ / pk_live_) will be rejected when this is active.
STRIPE_TEST_MODE=true
NEXT_PUBLIC_STRIPE_TEST_MODE=true

# Stripe Test API Keys (Get from: https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_SECRET_KEY=sk_test_your_test_secret_key

# Stripe Test Webhook Signing Secret
# Local testing (via Stripe CLI): stripe listen --forward-to localhost:3000/api/stripe/webhook
# Vercel deployment: From Stripe Dashboard -> Developers -> Webhooks (Test endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_signing_secret

# Public Site URL (for Stripe redirects and webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Email Notification Service (TEST / PREVIEW MODE ONLY)
# ==============================================================================
# Set to 'preview' so no real emails are dispatched to customers.
# Emails will be previewed in console / MongoDB audit log.
EMAIL_MODE=preview

# Optional: If you want test emails sent to YOUR email during testing:
EMAIL_TEST_RECIPIENT=

# Optional SMTP Relay (for sending preview emails to EMAIL_TEST_RECIPIENT):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Sillhouete Atelier" <no-reply@sillhouete.com>

