# ==============================================================================
# Sillhouete Environment Variables Configuration
# Copy this file to .env.local for local development or configure in your live
# hosting platform (Vercel, Netlify, Render, Railway, AWS, etc.)
# ==============================================================================

# MongoDB Connection String (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/sillhouete?retryWrites=true&w=majority

# Stripe API Keys (Test or Live)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_SECRET_KEY=sk_test_placeholder_key_here

# Admin Dashboard & Auth
ADMIN_SECRET=admin123
NEXTAUTH_SECRET=sillhouete_secret_key_2026
